{
  "name": "certificados-altura-mambuscay-backend",
  "version": "0.1.0",
  "description": "API REST de CERTIFICADOS ALTURA MAMBUSCAY (Node.js + Express + MySQL)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.js",
    "db:reset": "node --env-file-if-exists=.env scripts/db-init.js --reset",
    "db:admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "db:demo": "node --env-file-if-exists=.env scripts/seed-demo.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "zod": "^4.6.5"
  }
}
