NODE_ENV=development
PORT=4000

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=certificados_altura_mambuscay
# Conexiones máximas del pool; en planes con límite (p. ej. Clever Cloud, 5) use 3
DB_CONNECTION_LIMIT=10

# Autenticación
JWT_SECRET=cambie-este-valor-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# URL pública del frontend donde se verifica un certificado (base del código QR)
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verificar

# Primer administrador (usado por npm run db:admin)
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS="Altura Mambuscay"
ADMIN_CORREO=admin@mambuscay.local
ADMIN_PASSWORD=CambieEstaClave123
